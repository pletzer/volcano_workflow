NTASKS = 10
TASKS = list(range(1, NTASKS + 1))

# Total attempts per task = 1 initial submission + MAX_RETRIES resubmissions.
MAX_RETRIES = 2


rule all:
    input:
        "results/total_time.txt"


rule run_task:
    input:
        "inputs/task_{i}.txt"
    output:
        "results/task_{i}.time"
    retries: MAX_RETRIES
    resources:
        slurm_partition="milan",
        cpus_per_task=1,
        # Any task whose sleep=X exceeds the current attempt's walltime gets
        # killed by SLURM for hitting the time limit; Snakemake sees the job
        # as failed and, thanks to `retries` above, resubmits it with the
        # next (larger) runtime automatically -- up to MAX_RETRIES times.
        #
        # `attempt` is supplied by Snakemake: an integer starting at 1 for
        # the first submission and incremented by 1 on each resubmission
        # (1, 2, 3, ...). Here runtime (in minutes) is set equal to attempt,
        # so walltime grows linearly: 1 minute, then 2, then 3. This formula
        # is ours to choose -- e.g. `attempt * 10` or `2 ** attempt` would
        # give a different growth rate.
        runtime=lambda wildcards, attempt: attempt,
        # Snakemake's retries only know that a job failed, not why -- it
        # can't tell a SLURM TIMEOUT (see runtime, above) apart from an
        # OUT_OF_MEMORY kill or any other failure (check `sacct -j <jobid>
        # --format=State,MaxRSS,ReqMem,Elapsed,Timelimit` or `seff <jobid>`
        # to find out which one actually happened). Since the resource
        # function has no way to see that, we grow mem_mb defensively on
        # every retry too, so a job that was actually killed for being
        # short on memory also gets more room next attempt.
        mem_mb=lambda wildcards, attempt: 512 * attempt,
    run:
        import re
        import time

        start = time.time()
        with open(input[0]) as f:
            content = f.read()
        sleep_val = int(re.search(r"sleep=(\d+)", content).group(1))
        time.sleep(sleep_val)
        elapsed = time.time() - start

        with open(output[0], "w") as f:
            f.write(f"{elapsed:.6f}\n")


rule sum_times:
    input:
        expand("results/task_{i}.time", i=TASKS)
    output:
        "results/total_time.txt"
    resources:
        slurm_partition="milan",
        mem_mb=256,
        cpus_per_task=1,
        runtime=5,
    run:
        total = 0.0
        for fname in input:
            with open(fname) as f:
                total += float(f.read().strip())

        with open(output[0], "w") as f:
            f.write(f"{total:.6f}\n")
