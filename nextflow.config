// Default parameters, can be overridden on the command line, e.g. --periods=2.5,5.0
params {
    input = "${projectDir}/input/1st_step_2D"   // contains one <period>s/data/ directory per period
    outdir = "output"
    periods = null          // comma-separated list of periods to process, null for all
    seed = null             // seed of the random number generators, null for random runs
    account = null          // Slurm account for the mahuika profile, null for your default account

    // Python environment, activated before each task
    python_module = "Python/3.14.4-foss-2026"
    venv = "${projectDir}/venv"

    // 2D inversion
    cell_size = 0.05        // grid resolution in degrees
    inv2d_n_iterations = 50000
    inv2d_burnin_iterations = 10000
    inv2d_n_chains = 8
    inv2d_memory = "32 GB"  // per task, multiplied by the attempt number on retries
    inv2d_time = "6h"

    // 1D inversion
    inv1d_n_iterations = 50000
    inv1d_burnin_iterations = 10000
    inv1d_n_chains = 8
    inv1d_batch_size = 16   // number of grid points per task
    inv1d_memory = "6 GB"   // per task, multiplied by the attempt number on retries
    inv1d_time = "2h"       // per task, i.e. for inv1d_batch_size grid points
}

workDir = "workdir"

process {
    // beforeScript = "module load ${params.python_module} && source ${params.venv}/bin/activate"

    withName: 'INV2D' {
        cpus = 1            // inv2D.py runs the chains one after the other
        memory = { MemoryUnit.of(params.inv2d_memory) * task.attempt }
        time = { Duration.of(params.inv2d_time) * task.attempt }
    }
    withName: 'MAKE_GRID' {
        cpus = 1
        memory = { 2.GB * task.attempt }
        time = { 30.min * task.attempt }
    }
    withName: 'INV1D' {
        // bayesbay runs the chains in parallel, unless the runs are seeded
        cpus = { params.seed != null ? 1 : params.inv1d_n_chains }
        memory = { MemoryUnit.of(params.inv1d_memory) * task.attempt }
        time = { Duration.of(params.inv1d_time) * task.attempt }
    }
}

profiles {
    // small, fast run of the whole workflow on the current node
    test {
        executor.cpus = 4   // used when running locally
        params.periods = "2.5,5.0"
        params.seed = 1234
        params.cell_size = 0.3
        params.inv2d_n_iterations = 2000
        params.inv2d_burnin_iterations = 500
        params.inv2d_n_chains = 4
        params.inv1d_n_iterations = 500
        params.inv1d_burnin_iterations = 100
        params.inv1d_n_chains = 2
        params.inv1d_batch_size = 8
        params.inv2d_memory = "4 GB"
        params.inv2d_time = "30m"
        params.inv1d_memory = "2 GB"
        params.inv1d_time = "30m"
    }

    // submit each task as a Slurm job on Mahuika, combine with test for a quick run: -profile test,mahuika
    mahuika {
        process {
            executor = 'slurm'
            clusterOptions = { params.account != null ? "--account=${params.account}" : '' }
            // retry tasks killed for running out of memory or time, with more resources
            errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
            maxRetries = 2
        }
        executor {
            queueSize = 100             // maximum number of jobs queued or running at a time
            submitRateLimit = '20/1min'
            pollInterval = '1 min'
            queueStatInterval = '5 min'
        }
    }
}
